<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.staff.repository.StaffRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="StaffResultMap" type="io.moer.booking.domain.staff.Staff">
        <id property="id" column="id"/>
        <result property="businessId" column="business_id"/>
        <result property="name" column="name"/>
        <result property="position" column="position"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="specialty" column="specialty"/>
        <result property="careerYears" column="career_years"/>
        <result property="profileImageUrl" column="profile_image_url"/>
        <result property="introduction" column="introduction"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.staff.Staff"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO staffs (
            business_id, name, position, phone, email, specialty,
            career_years, profile_image_url, introduction, is_active
        ) VALUES (
                     #{businessId}, #{name}, #{position}, #{phone}, #{email}, #{specialty},
                     #{careerYears}, #{profileImageUrl}, #{introduction}, #{isActive}
                 )
    </insert>

    <!-- ========================================
         수정 (UPDATE)
         ======================================== -->

    <!-- 전체 필드 수정 -->
    <update id="update">
        UPDATE staffs
        SET name = #{name},
            position = #{position},
            phone = #{phone},
            email = #{email},
            specialty = #{specialty},
            career_years = #{careerYears},
            profile_image_url = #{profileImageUrl},
            introduction = #{introduction},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 활성 여부 토글 -->
    <update id="toggleActive">
        UPDATE staffs
        SET is_active = CASE WHEN is_active = 'Y' THEN 'N' ELSE 'Y' END,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- ========================================
         삭제 (DELETE)
         ======================================== -->
    <delete id="delete">
        DELETE FROM staffs
        WHERE id = #{id}
    </delete>

    <!-- ========================================
         조회 - 단건
         ======================================== -->

    <!-- ID로 조회 -->
    <select id="findById" resultMap="StaffResultMap">
        SELECT * FROM staffs
        WHERE id = #{id}
    </select>

    <!-- ========================================
         조회 - 목록
         ======================================== -->

    <!-- Business의 전체 Staff 조회 -->
    <select id="findByBusinessId" resultMap="StaffResultMap">
        SELECT * FROM staffs
        WHERE business_id = #{businessId}
        ORDER BY created_at DESC
    </select>

    <!-- Business의 활성 Staff 조회 -->
    <select id="findActiveByBusinessId" resultMap="StaffResultMap">
        SELECT * FROM staffs
        WHERE business_id = #{businessId}
          AND is_active = 'Y'
        ORDER BY created_at DESC
    </select>

    <!-- ========================================
         검증 쿼리
         ======================================== -->

    <!-- ID 존재 확인 -->
    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM staffs WHERE id = #{id})
    </select>

    <!-- Business의 직원 존재 확인 -->
    <select id="existsByBusinessIdAndId" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM staffs
            WHERE business_id = #{businessId} AND id = #{id}
        )
    </select>

    <!-- Business의 직원 수 조회 -->
    <select id="countByBusinessId" resultType="long">
        SELECT COUNT(*) FROM staffs
        WHERE business_id = #{businessId}
    </select>

</mapper>