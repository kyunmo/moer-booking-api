<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.staff.repository.StaffRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="StaffResultMap" type="io.moer.booking.domain.staff.Staff">
        <id property="id" column="id"/>
        <result property="businessId" column="business_id"/>
        <result property="name" column="name"/>
        <result property="position" column="position"/>
        <result property="positionId" column="position_id"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="specialty" column="specialty"/>
        <result property="careerYears" column="career_years"/>
        <result property="profileImageUrl" column="profile_image_url"/>
        <result property="introduction" column="introduction"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.staff.Staff"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO staffs (
            business_id, name, position, position_id, phone, email, specialty,
            career_years, profile_image_url, introduction, is_active
        ) VALUES (
                     #{businessId}, #{name}, #{position}, #{positionId}, #{phone}, #{email}, #{specialty},
                     #{careerYears}, #{profileImageUrl}, #{introduction}, #{isActive}
                 )
    </insert>

    <!-- ========================================
         수정 (UPDATE)
         ======================================== -->

    <!-- 전체 필드 수정 -->
    <update id="update">
        UPDATE staffs
        SET name = #{name},
            position = #{position},
            position_id = #{positionId},
            phone = #{phone},
            email = #{email},
            specialty = #{specialty},
            career_years = #{careerYears},
            profile_image_url = #{profileImageUrl},
            introduction = #{introduction},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 프로필 이미지 URL 수정 -->
    <update id="updateProfileImageUrl">
        UPDATE staffs
        SET profile_image_url = #{profileImageUrl},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 활성 여부 토글 -->
    <update id="toggleActive">
        UPDATE staffs
        SET is_active = CASE WHEN is_active = 'Y' THEN 'N' ELSE 'Y' END,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 직원 비활성화 -->
    <update id="deactivate">
        UPDATE staffs
        SET is_active = 'N',
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 매장의 모든 직원 비활성화 -->
    <update id="deactivateByBusinessId">
        UPDATE staffs
        SET is_active = 'N',
            updated_at = CURRENT_TIMESTAMP
        WHERE business_id = #{businessId}
    </update>

    <!-- ========================================
         삭제 (DELETE)
         ======================================== -->
    <delete id="delete">
        DELETE FROM staffs
        WHERE id = #{id}
    </delete>

    <!-- ========================================
         조회 - 단건
         ======================================== -->

    <!-- ID로 조회 -->
    <select id="findById" resultMap="StaffResultMap">
        SELECT * FROM staffs
        WHERE id = #{id}
    </select>

    <!-- ========================================
         조회 - 목록
         ======================================== -->

    <!-- Business의 전체 Staff 조회 -->
    <select id="findByBusinessId" resultMap="StaffResultMap">
        SELECT * FROM staffs
        WHERE business_id = #{businessId}
        ORDER BY created_at DESC
    </select>

    <!-- Business의 활성 Staff 조회 -->
    <select id="findActiveByBusinessId" resultMap="StaffResultMap">
        SELECT * FROM staffs
        WHERE business_id = #{businessId}
          AND is_active = 'Y'
        ORDER BY created_at DESC
    </select>

    <!-- ========================================
         검증 쿼리
         ======================================== -->

    <!-- ID 존재 확인 -->
    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM staffs WHERE id = #{id})
    </select>

    <!-- Business의 직원 존재 확인 -->
    <select id="existsByBusinessIdAndId" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM staffs
            WHERE business_id = #{businessId} AND id = #{id}
        )
    </select>

    <!-- Business의 직원 수 조회 -->
    <select id="countByBusinessId" resultType="long">
        SELECT COUNT(*) FROM staffs
        WHERE business_id = #{businessId}
    </select>

    <!-- ========================================
         조건 기반 검색
         ======================================== -->

    <!-- 검색 공통 WHERE 조건 -->
    <sql id="searchCondition">
        <where>
            <if test="businessId != null">
                AND s.business_id = #{businessId}
            </if>
            <if test="name != null and name != ''">
                AND s.name LIKE '%' || #{name} || '%'
            </if>
            <if test="positionId != null">
                AND s.position_id = #{positionId}
            </if>
            <if test="specialty != null and specialty != ''">
                AND s.specialty LIKE '%' || #{specialty} || '%'
            </if>
            <if test="isActive != null">
                <choose>
                    <when test="isActive == true">AND s.is_active = 'Y'</when>
                    <otherwise>AND s.is_active = 'N'</otherwise>
                </choose>
            </if>
            <if test="minCareerYears != null">
                AND s.career_years >= #{minCareerYears}
            </if>
        </where>
    </sql>

    <!-- 조건 기반 검색 -->
    <select id="findByCondition" parameterType="io.moer.booking.domain.staff.dto.StaffSearchCondition"
            resultMap="StaffResultMap">
        SELECT s.* FROM staffs s
        <include refid="searchCondition"/>
        <choose>
            <when test="sortBy == 'name'">ORDER BY s.name</when>
            <when test="sortBy == 'position'">ORDER BY s.position</when>
            <when test="sortBy == 'career_years'">ORDER BY s.career_years</when>
            <otherwise>ORDER BY s.created_at</otherwise>
        </choose>
        <choose>
            <when test="sortOrder == 'asc'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
    </select>

    <!-- 조건 기반 검색 결과 수 -->
    <select id="countByCondition" parameterType="io.moer.booking.domain.staff.dto.StaffSearchCondition"
            resultType="int">
        SELECT COUNT(*) FROM staffs s
        <include refid="searchCondition"/>
    </select>

</mapper>