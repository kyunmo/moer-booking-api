<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.staff.repository.PortfolioRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="PortfolioResultMap" type="io.moer.booking.domain.staff.Portfolio">
        <id property="id" column="id"/>
        <result property="staffId" column="staff_id"/>
        <result property="businessId" column="business_id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="imageUrl" column="image_url"/>
        <result property="tags" column="tags"/>
        <result property="isVisible" column="is_visible"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.staff.Portfolio"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO portfolios (
            staff_id, title, description, image_url, tags, is_visible
        ) VALUES (
                     #{staffId}, #{title}, #{description}, #{imageUrl}, #{tags}, #{isVisible}
                 )
    </insert>

    <!-- ========================================
         수정 (UPDATE)
         ======================================== -->

    <!-- 공개 여부 토글 -->
    <update id="toggleVisibility">
        UPDATE portfolios
        SET is_visible = CASE WHEN is_visible = 'Y' THEN 'N' ELSE 'Y' END
        WHERE id = #{id}
    </update>

    <!-- ========================================
         삭제 (DELETE)
         ======================================== -->
    <delete id="delete">
        DELETE FROM portfolios
        WHERE id = #{id}
    </delete>

    <!-- ========================================
         조회 - 단건
         ======================================== -->

    <!-- ID로 조회 (businessId JOIN) -->
    <select id="findById" resultMap="PortfolioResultMap">
        SELECT p.*, s.business_id
        FROM portfolios p
                 INNER JOIN staffs s ON p.staff_id = s.id
        WHERE p.id = #{id}
    </select>

    <!-- ========================================
         조회 - 목록
         ======================================== -->

    <!-- Staff의 전체 Portfolio 조회 (businessId JOIN) -->
    <select id="findByStaffId" resultMap="PortfolioResultMap">
        SELECT p.*, s.business_id
        FROM portfolios p
                 INNER JOIN staffs s ON p.staff_id = s.id
        WHERE p.staff_id = #{staffId}
        ORDER BY p.created_at DESC
    </select>

    <!-- Staff의 공개 Portfolio 조회 (businessId JOIN) -->
    <select id="findVisibleByStaffId" resultMap="PortfolioResultMap">
        SELECT p.*, s.business_id
        FROM portfolios p
                 INNER JOIN staffs s ON p.staff_id = s.id
        WHERE p.staff_id = #{staffId}
          AND p.is_visible = 'Y'
        ORDER BY p.created_at DESC
    </select>

    <!-- Business의 전체 Portfolio 조회 -->
    <select id="findByBusinessId" resultMap="PortfolioResultMap">
        SELECT p.*, s.business_id
        FROM portfolios p
                 INNER JOIN staffs s ON p.staff_id = s.id
        WHERE s.business_id = #{businessId}
        ORDER BY p.created_at DESC
    </select>

    <!-- ========================================
         검증 쿼리
         ======================================== -->

    <!-- ID 존재 확인 -->
    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM portfolios WHERE id = #{id})
    </select>

</mapper>