<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.staff.position.repository.StaffPositionRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="StaffPositionResultMap" type="io.moer.booking.domain.staff.position.StaffPosition">
        <id property="id" column="id"/>
        <result property="businessId" column="business_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.staff.position.StaffPosition"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO staff_positions (
            business_id, name, description, sort_order
        ) VALUES (
            #{businessId}, #{name}, #{description}, #{sortOrder}
        )
    </insert>

    <!-- ========================================
         수정 (UPDATE)
         ======================================== -->
    <update id="update">
        UPDATE staff_positions
        SET name = #{name},
            description = #{description},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 정렬 순서 변경 -->
    <update id="updateSortOrder">
        UPDATE staff_positions
        SET sort_order = #{sortOrder},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- ========================================
         삭제 (DELETE)
         ======================================== -->
    <delete id="delete">
        DELETE FROM staff_positions WHERE id = #{id}
    </delete>

    <!-- ========================================
         조회 - 단건
         ======================================== -->
    <select id="findById" resultMap="StaffPositionResultMap">
        SELECT * FROM staff_positions WHERE id = #{id}
    </select>

    <!-- ========================================
         조회 - 목록
         ======================================== -->
    <select id="findByBusinessId" resultMap="StaffPositionResultMap">
        SELECT * FROM staff_positions
        WHERE business_id = #{businessId}
        ORDER BY sort_order ASC, name ASC
    </select>

    <!-- ========================================
         검증 쿼리
         ======================================== -->
    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM staff_positions WHERE id = #{id})
    </select>

    <select id="existsByBusinessIdAndId" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM staff_positions
            WHERE business_id = #{businessId} AND id = #{id}
        )
    </select>

    <select id="existsByBusinessIdAndName" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM staff_positions
            WHERE business_id = #{businessId} AND name = #{name}
        )
    </select>

    <select id="existsByBusinessIdAndNameAndIdNot" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM staff_positions
            WHERE business_id = #{businessId} AND name = #{name} AND id != #{id}
        )
    </select>

    <select id="countStaffsByPositionId" resultType="int">
        SELECT COUNT(*) FROM staffs WHERE position_id = #{positionId}
    </select>

    <select id="getMaxSortOrderByBusinessId" resultType="int">
        SELECT COALESCE(MAX(sort_order), 0) FROM staff_positions
        WHERE business_id = #{businessId}
    </select>

</mapper>
