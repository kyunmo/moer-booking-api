<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.holiday.repository.SpecialHolidayRepository">

    <!-- ResultMap -->
    <resultMap id="SpecialHolidayResultMap" type="io.moer.booking.domain.holiday.SpecialHoliday">
        <id property="id" column="id"/>
        <result property="businessId" column="business_id"/>
        <result property="name" column="name"/>
        <result property="date" column="date"/>
        <result property="type" column="type"/>
        <result property="reason" column="reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 생성 -->
    <insert id="save" parameterType="io.moer.booking.domain.holiday.SpecialHoliday"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO special_holidays (
            business_id, name, date, type, reason
        ) VALUES (
                     #{businessId}, #{name}, #{date}, #{type}, #{reason}
                 )
    </insert>

    <!-- 단건 조회 -->
    <select id="findById" resultMap="SpecialHolidayResultMap">
        SELECT * FROM special_holidays
        WHERE id = #{id}
    </select>

    <!-- Business의 전체 휴무일 조회 -->
    <select id="findByBusinessId" resultMap="SpecialHolidayResultMap">
        SELECT * FROM special_holidays
        WHERE business_id = #{businessId}
        ORDER BY date ASC
    </select>

    <!-- Business의 특정 기간 휴무일 조회 -->
    <select id="findByBusinessIdAndDateRange" resultMap="SpecialHolidayResultMap">
        SELECT * FROM special_holidays
        WHERE business_id = #{businessId}
          AND date BETWEEN #{startDate} AND #{endDate}
        ORDER BY date ASC
    </select>

    <!-- Business의 특정 날짜 휴무일 조회 -->
    <select id="findByBusinessIdAndDate" resultMap="SpecialHolidayResultMap">
        SELECT * FROM special_holidays
        WHERE business_id = #{businessId}
          AND date = #{date}
    </select>

    <!-- Business의 특정 연도 휴무일 조회 -->
    <select id="findByBusinessIdAndYear" resultMap="SpecialHolidayResultMap">
        SELECT * FROM special_holidays
        WHERE business_id = #{businessId}
          AND EXTRACT(YEAR FROM date) = #{year}
        ORDER BY date ASC
    </select>

    <!-- 존재 여부 확인 (businessId + id) -->
    <select id="existsByBusinessIdAndId" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM special_holidays
            WHERE business_id = #{businessId}
              AND id = #{id}
        )
    </select>

    <!-- 존재 여부 확인 (businessId + date) -->
    <select id="existsByBusinessIdAndDate" resultType="boolean">
        SELECT EXISTS(
            SELECT 1 FROM special_holidays
            WHERE business_id = #{businessId}
              AND date = #{date}
        )
    </select>

    <!-- 삭제 (ID) -->
    <delete id="delete">
        DELETE FROM special_holidays
        WHERE id = #{id}
    </delete>

    <!-- 삭제 (날짜) -->
    <delete id="deleteByBusinessIdAndDate">
        DELETE FROM special_holidays
        WHERE business_id = #{businessId}
          AND date = #{date}
    </delete>

</mapper>