<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.review.repository.ReviewImageRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="ReviewImageResultMap" type="io.moer.booking.domain.review.ReviewImage">
        <id property="id" column="id"/>
        <result property="reviewId" column="review_id"/>
        <result property="imageUrl" column="image_url"/>
        <result property="thumbnailUrl" column="thumbnail_url"/>
        <result property="originalFilename" column="original_filename"/>
        <result property="fileSize" column="file_size"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.review.ReviewImage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO review_images (review_id, image_url, thumbnail_url, original_filename, file_size, sort_order)
        VALUES (#{reviewId}, #{imageUrl}, #{thumbnailUrl}, #{originalFilename}, #{fileSize}, #{sortOrder})
    </insert>

    <!-- ========================================
         조회
         ======================================== -->

    <!-- ID로 조회 -->
    <select id="findById" resultMap="ReviewImageResultMap">
        SELECT * FROM review_images WHERE id = #{id}
    </select>

    <!-- 리뷰 ID로 이미지 목록 조회 -->
    <select id="findByReviewId" resultMap="ReviewImageResultMap">
        SELECT * FROM review_images
        WHERE review_id = #{reviewId}
        ORDER BY sort_order ASC, created_at ASC
    </select>

    <!-- 리뷰 ID로 이미지 수 조회 -->
    <select id="countByReviewId" resultType="int">
        SELECT COUNT(*) FROM review_images WHERE review_id = #{reviewId}
    </select>

    <!-- ========================================
         삭제
         ======================================== -->

    <!-- ID로 삭제 -->
    <delete id="deleteById">
        DELETE FROM review_images WHERE id = #{id}
    </delete>

    <!-- 리뷰 ID로 전체 이미지 삭제 -->
    <delete id="deleteByReviewId">
        DELETE FROM review_images WHERE review_id = #{reviewId}
    </delete>

</mapper>
