<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.broadcast.repository.BroadcastRepository">

    <resultMap id="BroadcastResultMap" type="io.moer.booking.domain.broadcast.Broadcast">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="targetType" column="target_type"/>
        <result property="priority" column="priority"/>
        <result property="sentBy" column="sent_by"/>
        <result property="sentAt" column="sent_at"/>
        <result property="status" column="status"/>
        <result property="recipientCount" column="recipient_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="save" parameterType="io.moer.booking.domain.broadcast.Broadcast"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO broadcasts (title, content, target_type, priority, sent_by, sent_at, status, recipient_count)
        VALUES (#{title}, #{content}, #{targetType}, #{priority}, #{sentBy}, #{sentAt}, #{status}, #{recipientCount})
    </insert>

    <select id="findById" resultMap="BroadcastResultMap">
        SELECT * FROM broadcasts WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BroadcastResultMap">
        SELECT * FROM broadcasts ORDER BY created_at DESC LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM broadcasts
    </select>

    <select id="findSentBroadcasts" resultMap="BroadcastResultMap">
        SELECT * FROM broadcasts WHERE status = 'SENT' ORDER BY sent_at DESC LIMIT #{size} OFFSET #{offset}
    </select>

</mapper>
