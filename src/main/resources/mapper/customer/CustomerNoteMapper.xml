<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.customer.repository.CustomerNoteRepository">

    <resultMap id="CustomerNoteResultMap" type="io.moer.booking.domain.customer.CustomerNote">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="businessId" column="business_id"/>
        <result property="content" column="content"/>
        <result property="isPrivate" column="is_private"/>
        <result property="authorId" column="author_id"/>
        <result property="authorName" column="author_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="save" parameterType="io.moer.booking.domain.customer.CustomerNote"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer_notes (customer_id, business_id, content, is_private, author_id, author_name)
        VALUES (#{customerId}, #{businessId}, #{content}, #{isPrivate}, #{authorId}, #{authorName})
    </insert>

    <select id="findById" resultMap="CustomerNoteResultMap">
        SELECT * FROM customer_notes WHERE id = #{id}
    </select>

    <select id="findByCustomerIdAndBusinessId" resultMap="CustomerNoteResultMap">
        SELECT * FROM customer_notes
        WHERE customer_id = #{customerId}
          AND business_id = #{businessId}
        ORDER BY created_at DESC
    </select>

    <update id="update" parameterType="io.moer.booking.domain.customer.CustomerNote">
        UPDATE customer_notes
        SET content = #{content},
            is_private = #{isPrivate},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM customer_notes WHERE id = #{id}
    </delete>

    <update id="updateCustomerId">
        UPDATE customer_notes
        SET customer_id = #{toCustomerId},
            updated_at = CURRENT_TIMESTAMP
        WHERE customer_id = #{fromCustomerId}
    </update>

    <select id="countByCustomerId" resultType="int">
        SELECT COUNT(*) FROM customer_notes WHERE customer_id = #{customerId}
    </select>
</mapper>
