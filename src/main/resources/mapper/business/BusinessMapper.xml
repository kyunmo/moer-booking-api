<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.business.repository.BusinessRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="BusinessResultMap" type="io.moer.booking.domain.business.Business">
        <id property="id" column="id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="name" column="name"/>
        <result property="businessType" column="business_type"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="phone" column="phone"/>
        <result property="address" column="address"/>
        <result property="description" column="description"/>
        <result property="businessHours" column="business_hours"
                typeHandler="io.moer.booking.common.mybatis.JsonTypeHandler"/>
        <result property="status" column="status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="dailyRevenueGoal" column="daily_revenue_goal"/>
        <result property="monthlyRevenueGoal" column="monthly_revenue_goal"/>
        <result property="monthlyNewCustomerGoal" column="monthly_new_customer_goal"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.business.Business"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO businesses (
            owner_id, name, business_type, phone, address, description,
            business_hours, status
        ) VALUES (
                     #{ownerId}, #{name}, #{businessType}, #{phone}, #{address}, #{description},
                     #{businessHours, typeHandler=io.moer.booking.common.mybatis.JsonTypeHandler}::jsonb,
                     #{status}
                 )
    </insert>

    <!-- ========================================
         수정 (UPDATE)
         ======================================== -->
    <update id="update">
        UPDATE businesses
        SET name = #{name},
            phone = #{phone},
            address = #{address},
            description = #{description},
            business_hours = #{businessHours, typeHandler=io.moer.booking.common.mybatis.JsonTypeHandler}::jsonb,
            status = #{status},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- ========================================
         삭제 (DELETE)
         ======================================== -->
    <delete id="delete">
        DELETE FROM businesses WHERE id = #{id}
    </delete>

    <!-- ========================================
         조회 - 단건
         ======================================== -->
    <select id="findById" resultMap="BusinessResultMap">
        SELECT * FROM businesses WHERE id = #{id}
    </select>

    <!-- ========================================
         조회 - 목록
         ======================================== -->

    <!-- 전체 조회 (검색 조건 포함, 페이징) -->
    <select id="findAll" resultMap="BusinessResultMap"
            parameterType="io.moer.booking.domain.business.dto.BusinessSearchCondition">
        SELECT * FROM businesses
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE '%' || #{keyword} || '%'
            </if>
            <if test="ownerId != null">
                AND owner_id = #{ownerId}
            </if>
            <if test="businessType != null">
                AND business_type = #{businessType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 전체 개수 (검색 조건 포함) -->
    <select id="countAll" resultType="long"
            parameterType="io.moer.booking.domain.business.dto.BusinessSearchCondition">
        SELECT COUNT(*) FROM businesses
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE '%' || #{keyword} || '%'
            </if>
            <if test="ownerId != null">
                AND owner_id = #{ownerId}
            </if>
            <if test="businessType != null">
                AND business_type = #{businessType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- Owner의 매장 목록 -->
    <select id="findByOwnerId" resultMap="BusinessResultMap">
        SELECT * FROM businesses
        WHERE owner_id = #{ownerId}
        ORDER BY created_at DESC
    </select>

    <!-- ========================================
         검증 쿼리
         ======================================== -->

    <!-- ID 존재 확인 -->
    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM businesses WHERE id = #{id})
    </select>

    <!-- Owner의 매장 개수 -->
    <select id="countByOwnerId" resultType="long">
        SELECT COUNT(*) FROM businesses WHERE owner_id = #{ownerId}
    </select>

</mapper>