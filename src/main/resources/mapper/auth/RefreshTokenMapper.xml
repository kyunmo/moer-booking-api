<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    SECURITY (P1-1): refresh_tokens.token_hash 는 BCrypt 해시 저장.
    조회는 user_id 기준, 검증은 Service 레이어에서 matches() 로 수행.
-->
<mapper namespace="io.moer.booking.domain.auth.repository.RefreshTokenRepository">

    <resultMap id="RefreshTokenResultMap" type="io.moer.booking.domain.auth.RefreshToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tokenHash" column="token_hash"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="save" parameterType="io.moer.booking.domain.auth.RefreshToken"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (
            user_id, token_hash, expires_at
        ) VALUES (
            #{userId}, #{tokenHash}, #{expiresAt}
        )
    </insert>

    <!-- User ID로 조회 (최근 1건) -->
    <select id="findByUserId" resultMap="RefreshTokenResultMap">
        SELECT * FROM refresh_tokens
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!-- User ID로 삭제 (해당 사용자의 모든 토큰) -->
    <delete id="deleteByUserId">
        DELETE FROM refresh_tokens
        WHERE user_id = #{userId}
    </delete>

    <!-- 만료된 토큰 삭제 -->
    <delete id="deleteExpiredTokens">
        DELETE FROM refresh_tokens
        WHERE expires_at <![CDATA[<]]> CURRENT_TIMESTAMP
    </delete>

</mapper>
