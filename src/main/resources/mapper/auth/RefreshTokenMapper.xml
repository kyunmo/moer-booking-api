<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.moer.booking.domain.auth.repository.RefreshTokenRepository">

    <!-- ========================================
         Result Map
         ======================================== -->
    <resultMap id="RefreshTokenResultMap" type="io.moer.booking.domain.auth.RefreshToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="token" column="token"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- ========================================
         생성 (INSERT)
         ======================================== -->
    <insert id="save" parameterType="io.moer.booking.domain.auth.RefreshToken"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (
            user_id, token, expires_at
        ) VALUES (
                     #{userId}, #{token}, #{expiresAt}
                 )
    </insert>

    <!-- ========================================
         조회 - 단건
         ======================================== -->

    <!-- Token으로 조회 -->
    <select id="findByToken" resultMap="RefreshTokenResultMap">
        SELECT * FROM refresh_tokens
        WHERE token = #{token}
    </select>

    <!-- User ID로 조회 -->
    <select id="findByUserId" resultMap="RefreshTokenResultMap">
        SELECT * FROM refresh_tokens
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
            LIMIT 1
    </select>

    <!-- ========================================
         삭제 (DELETE)
         ======================================== -->

    <!-- User ID로 삭제 -->
    <delete id="deleteByUserId">
        DELETE FROM refresh_tokens
        WHERE user_id = #{userId}
    </delete>

    <!-- Token으로 삭제 -->
    <delete id="deleteByToken">
        DELETE FROM refresh_tokens
        WHERE token = #{token}
    </delete>

    <!-- 만료된 토큰 삭제 -->
    <delete id="deleteExpiredTokens">
        DELETE FROM refresh_tokens
        WHERE expires_at <![CDATA[<]]> CURRENT_TIMESTAMP
    </delete>

</mapper>